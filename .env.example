# =========================================================================
# imparando — variables de entorno
# =========================================================================
# Copiá este archivo a .env.local y completá los valores.
# .env.local NUNCA se commitea (está en .gitignore).
#
# Hay DOS entornos de base de datos totalmente separados:
#   - desarrollo -> proyecto Supabase "imparando-dev"
#   - producción -> proyecto Supabase "imparando-prod" (variables en el host)
# Nunca apuntes tu .env.local local a la base de producción.
# =========================================================================

# --- Supabase: API pública (cliente y servidor) ---------------------------
# Project Settings > API > Project URL / anon public key
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# --- Supabase: clave de servicio (SOLO servidor / scripts admin) ----------
# Project Settings > API > service_role. Nunca se expone al cliente.
SUPABASE_SERVICE_ROLE_KEY=""

# --- PostgreSQL: acceso de Drizzle ---------------------------------------
# Runtime de la app (pooler de transacciones, puerto 6543, ?pgbouncer=true).
# Project Settings > Database > Connection string > Transaction pooler
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Migraciones de Drizzle Kit (conexión directa, puerto 5432, sin pooler).
# Project Settings > Database > Connection string > Direct connection
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
